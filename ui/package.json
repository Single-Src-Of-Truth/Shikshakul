  "scripts": {
    "start": "nx run-many -t serve --all --parallel=3",
    "start:admin": "nx serve administrator-portal",
    "start:teacher": "nx serve teacher-portal",
    "start:guardian": "nx serve guardian-portal",
    "build:all": "nx run-many -t build --all",
    "build:admin": "nx build administrator-portal",
    "build:teacher": "nx build teacher-portal",
    "build:guardian": "nx build guardian-portal",
    "lint:all": "nx run-many -t lint --all",
    "lint:admin": "nx lint administrator-portal",
    "lint:teacher": "nx lint teacher-portal",
    "lint:guardian": "nx lint guardian-portal",
    "test:all": "nx run-many -t test --all",
    "graph": "nx graph"
  },
  "private": true,
  "author": "Shikshakul Engineering Team",
